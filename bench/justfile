set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]

export UV_PROJECT_ENVIRONMENT := data_local_directory() / "uv" / "envs" / "videos-subs"

[group('project')]
[doc('List recipes')]
default:
    @just --list --unsorted

[group('run')]
[doc('Evaluate every run not evaluated yet, each with its own llama server')]
all: sources
    uv run bench.py all

[group('run')]
[doc('List runs and their progress')]
runs:
    uv run bench.py runs

[group('run')]
[doc('Translate, fix and check run with llama server already started')]
bench run: (translate run) (fix run) (check run)

[group('run')]
[doc('Translate sources with run')]
translate run: sources
    uv run bench.py translate {{run}}

[group('run')]
[doc('Fix translations of run')]
fix run:
    uv run bench.py fix {{run}}

[group('run')]
[doc('Check translations of run')]
check run:
    uv run bench.py check {{run}}

[group('run')]
[doc('Score translations and Claude references against references')]
score:
    uv run bench.py score

[group('run')]
[doc('Show scores, issues and times of all runs')]
report:
    uv run bench.py report
alias scores := report

[group('run')]
[doc('Write entries of all runs side by side')]
compare:
    uv run bench.py compare

[group('llm')]
[doc('Start llama server for model')]
llama model:
    uv run bench.py serve {{model}}

[group('data')]
[doc('Download models')]
models *names:
    uv run --with huggingface_hub bench.py download {{names}}

[group('data')]
[doc('Copy English sources and official references from library')]
sources:
    uv run bench.py sources
