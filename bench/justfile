set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]
set script-interpreter := ["pwsh.exe", "-NoLogo", "-NoProfile"]

export UV_PROJECT_ENVIRONMENT := data_local_directory() / "uv" / "envs" / "videos-subs"
export PYTHONPATH := source_directory() / ".." / "src"

[group('project')]
[doc('List recipes')]
default:
    @just --list --unsorted

[group('project')]
[doc('Download models')]
[script]
[extension('.ps1')]
[positional-arguments]
models *names:
    uv run --with huggingface_hub bench.py download @args
    exit $LASTEXITCODE

[group('run')]
[doc('Translate pending runs')]
[script]
[extension('.ps1')]
[positional-arguments]
run *arguments:
    uv run bench.py run @args
    exit $LASTEXITCODE

[group('run')]
[doc('Check and score pending translations')]
score:
    uv run bench.py score

[group('run')]
[doc('Show scores, issues and times of all runs')]
report:
    uv run bench.py report

[group('run')]
[doc('Write entries of all runs side by side')]
compare:
    uv run bench.py compare

[group('run')]
[doc('List runs and their progress')]
runs:
    uv run bench.py runs
