set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]
set script-interpreter := ["pwsh.exe", "-NoLogo", "-NoProfile"]

export UV_PROJECT_ENVIRONMENT := data_local_directory() / "_dev" / "uv" / "envs" / "videos-subs"
export UV_FROZEN := "1"
export PYTHONPATH := source_directory() / ".." / "src"

[group('project')]
[doc('List recipes')]
default:
    @just --list --unsorted

[group('project')]
[doc('Download models')]
[script]
[extension('.ps1')]
[positional-arguments]
models *names:
    uv run --with huggingface_hub benchmark-models.py download @args
    exit $LASTEXITCODE

[group('run')]
[doc('Translate pending runs')]
[script]
[extension('.ps1')]
[positional-arguments]
run *arguments:
    uv run benchmark-models.py run @args
    exit $LASTEXITCODE

[group('run')]
[doc('Check and score pending translations')]
score:
    uv run benchmark-models.py score

[group('run')]
[doc('Show scores, issues and times of all runs')]
report:
    uv run benchmark-models.py report

[group('run')]
[doc('Write entries of runs side by side')]
[script]
[extension('.ps1')]
[positional-arguments]
compare *arguments:
    uv run benchmark-models.py compare @args
    exit $LASTEXITCODE

[group('run')]
[doc('List runs and their progress')]
runs:
    uv run benchmark-models.py runs
