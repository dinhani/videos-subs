set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]

export UV_PROJECT_ENVIRONMENT := data_local_directory() / "uv" / "envs" / "videos-subs"

[group('project')]
[doc('List recipes')]
default:
    @just --list --unsorted

[group('run')]
[doc('Translate runs not translated yet; pass run names or --pick')]
run *arguments:
    uv run bench.py run {{arguments}}

[group('run')]
[doc('Check and score translations not checked or scored yet, without translating')]
score:
    uv run bench.py score

[group('run')]
[doc('Show scores, issues and times of all runs')]
report:
    uv run bench.py report

[group('run')]
[doc('Write entries of all runs side by side')]
compare:
    uv run bench.py compare

[group('run')]
[doc('List runs and their progress')]
runs:
    uv run bench.py runs

[group('data')]
[doc('Download models')]
models *names:
    uv run --with huggingface_hub bench.py download {{names}}
